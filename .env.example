# DemandIQ Environment Variables Example
# Copy this file to .env for local deployment

# Port & App URL
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security & Authentication
# Strong secret key for JWT session tokens (use 32+ random characters in production)
JWT_SECRET="demandiq_development_jwt_secret_key_exathon_2026_demo"

# Server-Side HMAC Salt for Privacy Lab Keyed Hashing
# NEVER expose this key to clients or external APIs
HMAC_SECRET_SALT="demandiq_privacy_hmac_secret_salt_2026_isolated_key"

# Database Configuration (Optional PostgreSQL for production, fallback to SQLite/embedded store)
# Example PostgreSQL: postgresql://demandiq_user:password@localhost:5432/demandiq
DATABASE_URL="sqlite:///./data/demandiq.db"

# Optional Gemini API Key for server-side semantic enquiry extraction if enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"
